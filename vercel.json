{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/programme-tahfiz-academique", "destination": "/programme-mixte", "permanent": true },
    { "source": "/programme-tahfiz-academique.html", "destination": "/programme-mixte", "permanent": true },
    { "source": "/programmes", "destination": "/programme-internat", "permanent": true },
    { "source": "/inscription", "destination": "/admission", "permanent": true },
    { "source": "/about", "destination": "/a-propos", "permanent": true },
    { "source": "/gallery", "destination": "/galerie", "permanent": true },
    { "source": "/testimonials", "destination": "/temoignages", "permanent": true }
  ]
}
